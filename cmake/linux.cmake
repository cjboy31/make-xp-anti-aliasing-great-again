# Native Linux beta: renderer and XPLM controls; not Wine or a diagnostic stub.
option(NATIVE_AA_BUILD_LINUX_LAYER "Build native Linux Vulkan layer and injected checks" OFF)
option(NATIVE_AA_BUILD_LINUX_PLUGIN "Build native Linux XPLM panel with external SDK" OFF)
set(NATIVE_AA_XPLANE_SDK "" CACHE PATH "External X-Plane SDK (never packaged)")
if(NATIVE_AA_BUILD_LINUX_LAYER OR NATIVE_AA_BUILD_LINUX_PLUGIN)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
    message(FATAL_ERROR "The Linux beta requires native Linux x86_64")
  endif()
  find_package(Threads REQUIRED)
endif()
if(NATIVE_AA_BUILD_LINUX_LAYER)
  if(NOT NATIVE_AA_BUILD_VULKAN_TESTS)
    message(FATAL_ERROR "Linux layer builds require Vulkan shaders/tests")
  endif()
  find_package(OpenSSL REQUIRED)
  add_library(native_aa_live_recorders OBJECT src/vulkan/compute_smaa_pipeline.cpp src/vulkan/native_taa_pipeline.cpp src/vulkan/native_depth_pipeline.cpp)
  set_target_properties(native_aa_live_recorders PROPERTIES POSITION_INDEPENDENT_CODE ON)
  target_include_directories(native_aa_live_recorders PRIVATE include third_party/smaa ${Vulkan_INCLUDE_DIRS})
  target_compile_features(native_aa_live_recorders PRIVATE cxx_std_17)
  target_compile_definitions(native_aa_live_recorders PRIVATE VK_NO_PROTOTYPES)
  target_compile_options(native_aa_live_recorders PRIVATE -fvisibility=hidden -include "${CMAKE_CURRENT_SOURCE_DIR}/src/vulkan/live_pipeline_dispatch.hpp" -Wno-missing-field-initializers)
  aa_warnings(native_aa_live_recorders)
  add_library(native_aa_live SHARED src/vulkan/live_layer_win.cpp $<TARGET_OBJECTS:native_aa_live_recorders>)
  target_include_directories(native_aa_live PRIVATE include third_party/smaa ${Vulkan_INCLUDE_DIRS})
  target_compile_features(native_aa_live PRIVATE cxx_std_17)
  target_compile_options(native_aa_live PRIVATE -fvisibility=hidden -Wno-missing-field-initializers -Wno-misleading-indentation)
  target_link_libraries(native_aa_live PRIVATE OpenSSL::Crypto Threads::Threads ${CMAKE_DL_LIBS} rt)
  target_link_options(native_aa_live PRIVATE -Wl,-Bsymbolic-functions "-Wl,--version-script=${CMAKE_CURRENT_SOURCE_DIR}/cmake/layer.exports")
  set_target_properties(native_aa_live PROPERTIES OUTPUT_NAME native-aa)
  aa_warnings(native_aa_live)
  add_executable(native_aa_activation_probe tests/activation_probe_win.cpp)
  target_link_libraries(native_aa_activation_probe PRIVATE Vulkan::Vulkan)
  target_compile_options(native_aa_activation_probe PRIVATE -Wno-missing-field-initializers)
  aa_warnings(native_aa_activation_probe)
  if(BUILD_TESTING)
    add_executable(live_channel_tests tests/live_channel_tests.cpp)
    target_include_directories(live_channel_tests PRIVATE include)
    target_compile_features(live_channel_tests PRIVATE cxx_std_17)
    target_link_libraries(live_channel_tests PRIVATE Threads::Threads rt)
    aa_warnings(live_channel_tests)
    add_test(NAME native-aa-linux-channel COMMAND live_channel_tests)
    add_executable(native_scene_layer_tests tests/native_scene_layer_tests.cpp)
    target_include_directories(native_scene_layer_tests PRIVATE third_party/smaa)
    target_link_libraries(native_scene_layer_tests PRIVATE native_aa_vulkan Threads::Threads rt)
    target_compile_options(native_scene_layer_tests PRIVATE -Wno-missing-field-initializers)
    aa_warnings(native_scene_layer_tests)
    foreach(shader IN ITEMS native_scene_test.vert native_scene_test.frag compute_state_test.comp native_taa_scene_test.vert native_taa_scene_test.frag native_taa_post_test.frag)
      string(REPLACE "_test" "" output "${shader}")
      string(REPLACE "_" "-" output "${output}")
      set(output "${CMAKE_CURRENT_BINARY_DIR}/shaders/${output}.spv")
      add_custom_command(OUTPUT "${output}" COMMAND "${GLSLANG_VALIDATOR}" -V --target-env vulkan1.3 "${CMAKE_CURRENT_SOURCE_DIR}/shaders/${shader}" -o "${output}" DEPENDS "shaders/${shader}" VERBATIM)
      list(APPEND layer_test_spirv "${output}")
    endforeach()
    add_custom_target(layer_test_shaders DEPENDS ${layer_test_spirv})
    add_dependencies(layer_test_shaders smaa_shaders)
    add_dependencies(native_scene_layer_tests layer_test_shaders)
    find_package(Python3 COMPONENTS Interpreter REQUIRED)
    add_test(NAME native-aa-linux-injected COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/test_linux_layer.py" "${CMAKE_CURRENT_BINARY_DIR}")
    set_tests_properties(native-aa-linux-injected PROPERTIES TIMEOUT 600)
  endif()
endif()
if(NATIVE_AA_BUILD_LINUX_PLUGIN)
  if(NOT EXISTS "${NATIVE_AA_XPLANE_SDK}/CHeaders/XPLM/XPLMPlugin.h")
    message(FATAL_ERROR "Supply the external X-Plane SDK path")
  endif()
  find_package(OpenGL REQUIRED)
  add_library(native_aa_plugin MODULE src/plugin/native_aa_plugin.cpp)
  target_include_directories(native_aa_plugin PRIVATE include "${NATIVE_AA_XPLANE_SDK}/CHeaders/XPLM")
  target_compile_features(native_aa_plugin PRIVATE cxx_std_17)
  target_compile_options(native_aa_plugin PRIVATE -fvisibility=hidden -Wno-misleading-indentation)
  target_link_libraries(native_aa_plugin PRIVATE OpenGL::GL Threads::Threads rt)
  target_link_options(native_aa_plugin PRIVATE "-Wl,--version-script=${CMAKE_CURRENT_SOURCE_DIR}/cmake/plugin.exports")
  set_target_properties(native_aa_plugin PROPERTIES PREFIX "" OUTPUT_NAME lin SUFFIX .xpl)
  aa_warnings(native_aa_plugin)
endif()
