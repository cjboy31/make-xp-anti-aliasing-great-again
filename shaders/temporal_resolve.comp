#version 450
// SPDX-License-Identifier: MIT
// Original conservative temporal resolve. No engine/third-party shader copied.
layout(local_size_x=8,local_size_y=8) in;
layout(constant_id=0) const bool forceReset=true;
layout(std140,set=0,binding=0) uniform Constants { vec4 dimensionsJitter;vec4 feedback; };
layout(set=0,binding=1) uniform sampler2D currentColor;
layout(set=0,binding=2) uniform sampler2D historyColor;
layout(set=0,binding=3) uniform sampler2D motionField;
layout(set=0,binding=4) uniform sampler2D previousDepth;
layout(set=0,binding=5) uniform sampler2D reactiveMask;
layout(rgba8,set=0,binding=6) writeonly uniform image2D target;
bool finite4(vec4 v){return !any(isnan(v)) && !any(isinf(v));}
vec3 ycocg(vec3 c){return vec3(dot(c,vec3(.25,.5,.25)),.5*c.r-.5*c.b,-.25*c.r+.5*c.g-.25*c.b);}
vec3 rgb(vec3 c){return vec3(c.x+c.y-c.z,c.x+c.z,c.x-c.y-c.z);}
vec3 encodeSRGB(vec3 v){v=clamp(v,0,1);return mix(1.055*pow(v,vec3(1.0/2.4))-.055,12.92*v,lessThanEqual(v,vec3(.0031308)));}
void main(){
    ivec2 p=ivec2(gl_GlobalInvocationID.xy),size=imageSize(target);
    if(any(greaterThanEqual(p,size)))return;
    vec4 current=texelFetch(currentColor,p,0);vec3 result=current.rgb;
    vec4 motion=texelFetch(motionField,p,0);
    vec2 delta=motion.xy+dimensionsJitter.zw;
    vec2 previousPixel=vec2(p)+delta,uv=(previousPixel+.5)/vec2(size);
    bool eligible=!forceReset && finite4(motion) && finite4(dimensionsJitter) && finite4(feedback) &&
        motion.w>.5 && all(equal(ivec2(dimensionsJitter.xy),size)) && all(greaterThanEqual(previousPixel,vec2(0))) &&
        all(lessThanEqual(previousPixel,vec2(size-1))) && length(motion.xy)<=feedback.z;
    // Reset never samples history or depth. All pixels are overwritten.
    if(eligible){
        float oldDepth=textureLod(previousDepth,uv,0).r;
        float reactive=texelFetch(reactiveMask,p,0).r;
        eligible=!isnan(oldDepth) && !isinf(oldDepth) && !isnan(reactive) && !isinf(reactive) &&
            abs(oldDepth-motion.z)<=max(feedback.w,0.0) && reactive<1.0;
        if(eligible){
            vec4 old=textureLod(historyColor,uv,0);
            vec3 low=vec3(1e9),high=vec3(-1e9);
            for(int y=-1;y<=1;++y)for(int x=-1;x<=1;++x){
                vec3 v=ycocg(texelFetch(currentColor,clamp(p+ivec2(x,y),ivec2(0),size-1),0).rgb);
                low=min(low,v);high=max(high,v);
            }
            // Clip history to the current neighborhood in luminance/chroma
            // space. No sharpening is used to conceal invalid reprojection.
            vec3 bounded=rgb(clamp(ycocg(old.rgb),low,high));
            float weight=mix(clamp(feedback.x,0,.95),clamp(feedback.y,0,.95),clamp(length(motion.xy)/max(feedback.z,1),0,1));
            weight*=1-clamp(reactive,0,1);
            if(finite4(old))result=mix(current.rgb,bounded,weight);
        }
    }
    imageStore(target,p,vec4(encodeSRGB(result),current.a));
}
